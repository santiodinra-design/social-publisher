{
  "name": "social-publisher",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,worker,web -c gray,yellow,cyan \"tsx watch server/index.ts\" \"tsx watch server/worker.ts\" \"vite\"",
    "build": "npm run typecheck && vite build",
    "start": "concurrently -k -n api,worker \"tsx server/index.ts\" \"tsx server/worker.ts\"",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.web.json && tsc -p tsconfig.desktop.json",
    "desktop:build": "npm run build && node scripts/build-desktop.mjs",
    "desktop:dev": "npm run desktop:build && electron .",
    "icon": "electron scripts/make-icon.cjs",
    "package": "npm run desktop:build && electron-builder --mac dir --arm64 && sh scripts/sign-adhoc.sh",
    "package:dmg": "npm run package && electron-builder --mac dmg --arm64 --prepackaged \"release/mac-arm64/Publisher.app\"",
    "windows:test": "cargo test --manifest-path windows/Cargo.toml -p publisher-core",
    "windows:build": "vite build && cargo build --release --manifest-path windows/Cargo.toml -p publisher",
    "windows:run": "windows\\target\\release\\Publisher.exe",
    "relay:test": "vitest run --config relay/vitest.config.ts",
    "relay:deploy": "npx wrangler deploy --config relay/wrangler.toml"
  },
  "engines": {
    "node": ">=22.13"
  },
  "devDependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/static": "^10.1.11",
    "@types/node": "^26.6.6",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "electron": "^45.3.2",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "fastify": "^5.12.8",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "zod": "^4.6.7"
  },
  "optionalDependencies": {
    "@ffprobe-installer/darwin-arm64": "^5.0.1"
  },
  "version": "1.0.0",
  "description": "Publish one video to YouTube, Instagram Reels and TikTok from one place.",
  "main": "dist-desktop/main.cjs",
  "author": "Publisher (personal build)",
  "build": {
    "appId": "local.socialpublisher.publisher",
    "productName": "Publisher",
    "copyright": "Personal build",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**",
      "dist-desktop/**",
      "package.json",
      "!**/*.map"
    ],
    "extraResources": [
      {
        "from": "node_modules/@ffprobe-installer/darwin-arm64/ffprobe",
        "to": "bin/ffprobe"
      },
      {
        "from": "build/ffprobe",
        "to": "licenses/ffprobe"
      }
    ],
    "asar": true,
    "npmRebuild": false,
    "nodeGypRebuild": false,
    "mac": {
      "category": "public.app-category.social-networking",
      "icon": "build/icon.icns",
      "target": [
        "dir"
      ],
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "extendInfo": {
        "NSHumanReadableCopyright": "Personal build",
        "LSMinimumSystemVersion": "12.0"
      }
    },
    "dmg": {
      "title": "Publisher ${version}"
    }
  }
}
